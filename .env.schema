# varlock schema (https://varlock.dev) for the keys in .env.example: what each is for,
# its type and whether it is secret. It holds no values, so commit it and let agents
# read it. Values stay in .env or a secret manager, and `varlock load` checks them.
# Setup, and how safe-ai-skill treats this file:
# https://github.com/solanabr/ai-kit/blob/main/docs/configuration.md#secrets-with-varlock
# Every key is optional and secret unless marked @sensitive=false. Each block repeats
# both, so it keeps its meaning when pasted into a schema with other defaults.
# @defaultSensitive=true @defaultRequired=false
# ---

# Helius API, read by the helius MCP server — get a key at https://dev.helius.xyz
# @sensitive @optional
HELIUS_API_KEY=

# QEDGen formal verification (needs the qedgen CLI): fill-sorry and generate.
# Key at https://console.mistral.ai
# @sensitive @optional
MISTRAL_API_KEY=

# QEDGen formal verification (needs the qedgen CLI): the aristotle commands.
# Key at https://aristotle.harmonic.fun
# @sensitive @optional
ARISTOTLE_API_KEY=

# TheGrid — for Colosseum project graph queries. Get a key at https://thegrid.id
# @sensitive @optional
THEGRID_API_KEY=

# TheGrid GraphQL endpoint. Not a secret; the default in the example works for most.
# @sensitive=false @optional @type=url @example="https://beta.node.thegrid.id/graphql"
THEGRID_GRAPHQL_ENDPOINT=

# QuickNode HTTP endpoint, for QuickNode RPC/Streams/DAS. Get endpoints at
# https://www.quicknode.com. Secret: the URL usually carries the endpoint's token.
# @sensitive @optional @type=url
QUICKNODE_RPC_URL=

# QuickNode WebSocket endpoint, for QuickNode RPC/Streams/DAS.
# Secret: the URL usually carries the endpoint's token.
# @sensitive @optional @type=url(allowedProtocols=[wss])
QUICKNODE_WSS_URL=

# QuickNode API key, for QuickNode RPC/Streams/DAS
# @sensitive @optional
QUICKNODE_API_KEY=

# X/Twitter — for the CT alpha research skill. Get a bearer token at https://developer.x.com
# @sensitive @optional
X_BEARER_TOKEN=

# DFlow — for DFlow order flow integration
# @sensitive @optional
DFLOW_API_KEY=
